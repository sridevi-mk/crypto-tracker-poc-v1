# Example environment variables for CryptoTracker

# App config
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptotracker?schema=public
# Optional: force file-backed user store during migration (`file` or `postgres`)
USER_STORE_BACKEND=postgres
# Optional: force file-backed alerts store during migration (`file` or `postgres`)
ALERTS_STORE_BACKEND=postgres

# Market & portfolio data
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_NETWORK=eth-mainnet
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Chat provider (OpenAI or Ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# App auth (required for /portfolio and /api/portfolio/*)
AUTH_SECRET=replace_with_a_long_random_secret
# Optional bootstrap admin login fallback
AUTH_USERNAME=admin
AUTH_PASSWORD=replace_with_a_strong_password

# Alerts delivery + dispatch
ALERTS_CRON_SECRET=replace_with_a_cron_secret
ALERTS_EMAIL_PROVIDER=log
ALERT_NOTIFICATION_EMAIL=you@example.com
ALERTS_EMAIL_FROM=alerts@yourdomain.com
RESEND_API_KEY=your_resend_api_key_here

# API rate limits (per minute)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_ALERTS_PER_MINUTE=60
RATE_LIMIT_ALERTS_DISPATCH_PER_MINUTE=20
RATE_LIMIT_AUTH_SIGNIN_PER_MINUTE=10
RATE_LIMIT_AUTH_SIGNUP_PER_MINUTE=5
